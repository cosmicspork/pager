{
  "manifest_version": 3,
  "name": "Pager capture",
  "version": "0.1.0",
  "description": "Keep Teams web active and use your own Teams/Outlook notification sounds; optionally capture and page through a local Pager collector.",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.cloud.microsoft/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "Pager" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
